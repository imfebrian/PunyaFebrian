.categories{max-width:1450px;margin:25px auto 0;display:flex;gap:8px;overflow:auto;padding-bottom:5px}.categories::-webkit-scrollbar{display:none}.chip{flex:none;padding:9px 14px;border-radius:9px;border:1px solid var(--line);background:var(--card);color:#9699a5;font-size:10px;font-weight:600;transition:.2s}.chip:hover,.chip.active{background:var(--violet);color:#0e0b16;border-color:var(--violet);transform:translateY(-2px)}
.section{max-width:1450px;margin:42px auto 0}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:17px}.section-head h2{font-family:Outfit;font-size:20px;letter-spacing:-.5px}.section-head p{color:#686c78;font-size:10px}
.continue-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.continue-card{height:95px;display:flex;gap:12px;padding:8px;background:var(--card);border:1px solid var(--line);border-radius:13px;transition:.25s;cursor:pointer}.continue-card:hover{transform:translateY(-4px);border-color:rgba(155,124,255,.35);background:#151722;box-shadow:0 12px 30px #0003}.continue-card img{width:125px;height:77px;object-fit:cover;border-radius:8px}.continue-info{min-width:0;padding-top:3px;flex:1}.continue-title{font-size:11px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.progress{height:3px;background:#292b34;margin-top:15px;border-radius:5px;overflow:hidden}.progress span{display:block;height:100%;width:65%;background:var(--violet);border-radius:5px}.continue-time{color:#676b77;font-size:9px;margin-top:6px}
.grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:28px 15px}.card{min-width:0;cursor:pointer;animation:fadeUp .45s both}.poster{aspect-ratio:16/10;position:relative;overflow:hidden;border-radius:12px;background:var(--card);border:1px solid var(--line)}.poster img{width:100%;height:100%;object-fit:cover;transition:transform .5s cubic-bezier(.2,.7,.2,1),filter .3s}.card:hover .poster img{transform:scale(1.07);filter:brightness(.78)}.card:hover .play{opacity:1;transform:translate(-50%,-50%) scale(1)}.rating{position:absolute;top:9px;left:9px;padding:5px 7px;background:rgba(7,8,11,.9);color:var(--violet2);border-radius:6px;font-size:9px;font-weight:800}.rating:before{content:"★ "}.badge-new{position:absolute;top:9px;right:9px;padding:5px 7px;background:var(--violet);color:#0c0912;border-radius:6px;font-size:8px;font-weight:900}.play{position:absolute;left:50%;top:50%;width:45px;height:45px;border-radius:50%;border:1px solid rgba(255,255,255,.2);background:rgba(10,10,14,.78);color:white;display:grid;place-items:center;transform:translate(-50%,-50%) scale(.8);opacity:0;transition:.25s;backdrop-filter:blur(10px)}.card-info{padding:11px 2px 0}.card-title{font-size:11px;font-weight:700;line-height:1.4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.card-meta{color:#6f727d;font-size:9px;margin-top:5px}.empty{display:none;text-align:center;color:var(--muted);padding:70px}
.modal{position:fixed;inset:0;z-index:200;display:none;place-items:center;padding:20px;background:rgba(0,0,0,.72);backdrop-filter:blur(12px);opacity:0;transition:opacity .2s}.modal.open{display:grid;opacity:1}.modal-box{width:min(760px,100%);max-height:90vh;overflow:auto;background:#11131a;border:1px solid var(--line);border-radius:20px;box-shadow:0 40px 120px rgba(0,0,0,.5);transform:translateY(15px) scale(.98);transition:transform .25s}.modal.open .modal-box{transform:translateY(0) scale(1)}.modal-cover{height:260px;background-size:cover;background-position:center;position:relative}.modal-cover:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,#11131a,transparent)}.close{position:absolute;right:17px;top:17px;width:34px;height:34px;border:0;border-radius:50%;background:rgba(0,0,0,.6);color:white;z-index:2;font-size:20px;transition:.2s}.close:hover{background:var(--violet);color:#100d18;transform:rotate(90deg)}.modal-content{padding:0 27px 28px;position:relative;margin-top:-25px}.modal-content h2{font-family:Outfit;font-size:28px}.modal-content p{color:#9699a5;font-size:11px;line-height:1.8;margin-top:12px}
.toast{position:fixed;left:50%;bottom:25px;z-index:300;transform:translate(-50%,20px);padding:11px 16px;border:1px solid var(--line);border-radius:12px;background:#191b26;color:#eee;font-size:11px;box-shadow:0 12px 35px #0008;opacity:0;pointer-events:none;transition:.25s}.toast.show{opacity:1;transform:translate(-50%,0)}
.skeleton{background:linear-gradient(90deg,#171923 25%,#222432 50%,#171923 75%);background-size:200% 100%;animation:shimmer 1.4s infinite}
@keyframes shimmer{to{background-position:-200% 0}}@keyframes rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}@keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
@media(max-width:1050px){.grid{grid-template-columns:repeat(4,minmax(0,1fr))}.continue-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:800px){.topbar{height:62px;padding:0 14px;gap:12px}.brand{min-width:auto}.brand-name{display:none}.sidebar{display:none}main{margin-left:0;padding:82px 14px 60px}.search{max-width:none}.actions{display:none}.hero{height:390px;border-radius:17px}.hero-content{left:23px;right:20px;bottom:28px}.hero h1{font-size:32px}.hero-desc{font-size:10px}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:23px 10px}.continue-grid{grid-template-columns:1fr}.continue-card{height:87px}.continue-card img{width:120px;height:69px}.section{margin-top:32px}.section-head h2{font-size:17px}.categories{margin-top:18px}}
@media(min-width:1500px){.grid{grid-template-columns:repeat(6,minmax(0,1fr))}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>
</head>
