.actions{display:flex;align-items:center;gap:12px}.icon-btn{width:36px;height:36px;border:0;border-radius:10px;background:transparent;color:#aaa;font-size:16px;transition:.2s}.icon-btn:hover{background:var(--card2);color:white;transform:translateY(-2px)}.avatar{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,#27233d,#171923);color:var(--violet2);font-size:10px;font-weight:800}
