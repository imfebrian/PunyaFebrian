main{margin-left:230px;padding:100px 34px 80px}
.hero{height:470px;max-width:1450px;margin:auto;position:relative;overflow:hidden;border-radius:22px;border:1px solid var(--line);background:#12141b;isolation:isolate}.hero-bg{position:absolute;inset:0;background-position:center;background-size:cover;transition:opacity .45s,transform 7s;z-index:-2}.hero:hover .hero-bg{transform:scale(1.035)}.hero-overlay{position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(7,8,12,.98) 0%,rgba(7,8,12,.86) 35%,rgba(7,8,12,.35) 70%,rgba(7,8,12,.1)),linear-gradient(0deg,rgba(7,8,12,.8),transparent 45%)}.hero-content{position:absolute;left:48px;bottom:45px;max-width:580px;animation:rise .55s both}.kicker{display:inline-flex;align-items:center;gap:7px;color:var(--violet2);font-size:9px;font-weight:800;letter-spacing:1.5px}.kicker i{width:5px;height:5px;background:var(--violet);border-radius:50%;box-shadow:0 0 12px var(--violet)}.hero h1{font-family:Outfit;font-size:48px;line-height:1;letter-spacing:-2px;margin-top:12px}.hero-meta{display:flex;gap:13px;color:#c4c6ce;font-size:10px;margin-top:13px;flex-wrap:wrap}.hero-meta span:not(:last-child):after{content:"•";margin-left:13px;color:#555864}.hero-desc{max-width:510px;color:#a5a8b2;font-size:11px;line-height:1.7;margin-top:13px}.hero-buttons{display:flex;gap:9px;margin-top:21px}.btn{border:0;border-radius:10px;padding:11px 17px;font-size:10px;font-weight:800;transition:transform .2s,box-shadow .2s,background .2s;position:relative;overflow:hidden}.btn:active,.chip:active,.icon-btn:active{transform:scale(.96)}.primary{color:#0d0b14;background:white}.primary:hover{box-shadow:0 0 30px rgba(255,255,255,.2);transform:translateY(-2px)}.secondary{color:white;background:rgba(255,255,255,.08);border:1px solid var(--line)}.secondary:hover{background:rgba(255,255,255,.15);transform:translateY(-2px)}
