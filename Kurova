<script>
/* Isi API_URL dengan endpoint milikmu. Jika kosong/gagal, demo otomatis dipakai. */
const API_URL = "https://api.jikan.moe/v4/seasons/now";
const demoAnime = [
{id:1,title:"Neon Horizon",poster:"https://images.unsplash.com/photo-1519608487953-e999c86e7455?w=1200&q=85",score:9.2,year:2026,genre:"Action",episodes:24,duration:"24m",description:"Sebuah perjalanan melintasi kota futuristik yang menyimpan misteri besar."},
{id:2,title:"Blue Archive",poster:"https://images.unsplash.com/photo-1518837695005-2083093ee35b?w=1200&q=85",score:8.9,year:2026,genre:"Adventure",episodes:13,duration:"23m",description:"Sekelompok karakter menghadapi masalah aneh yang semakin besar."},
{id:3,title:"After Rain",poster:"https://images.unsplash.com/photo-1470770841072-f978cf4d019e?w=1200&q=85",score:8.7,year:2025,genre:"Drama",episodes:12,duration:"24m",description:"Cerita tenang tentang pertemuan, kehilangan, dan kesempatan kedua."},
{id:4,title:"Astral Code",poster:"https://images.unsplash.com/photo-1462331940025-496dfbfc7564?w=1200&q=85",score:9.0,year:2026,genre:"Fantasy",episodes:24,duration:"24m",description:"Sebuah kode misterius membuka jalan menuju dunia yang tidak dikenal."},
{id:5,title:"Night Parade",poster:"https://images.unsplash.com/photo-1519608487953-e999c86e7455?w=1200&q=85&sat=-40",score:8.6,year:2025,genre:"Comedy",episodes:12,duration:"22m",description:"Malam biasa berubah menjadi kekacauan setelah sebuah festival dimulai."},
{id:6,title:"Parallel Days",poster:"https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?w=1200&q=85",score:8.8,year:2025,genre:"Romance",episodes:13,duration:"24m",description:"Dua kehidupan berjalan bersamaan dan perlahan mulai saling bertemu."},
{id:7,title:"Zero Signal",poster:"https://images.unsplash.com/photo-1519608487953-e999c86e7455?w=1200&q=85&blur=1",score:9.1,year:2026,genre:"Action",episodes:25,duration:"24m",description:"Sinyal misterius membawa sekelompok anak muda menuju konspirasi besar."},
{id:8,title:"Moonlit City",poster:"https://images.unsplash.com/photo-1519681393784-d120267933ba?w=1200&q=85",score:8.5,year:2025,genre:"Fantasy",episodes:12,duration:"23m",description:"Kota yang hanya muncul ketika bulan mencapai bentuk tertentu."},
{id:9,title:"Summer Loop",poster:"https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=1200&q=85",score:8.9,year:2025,genre:"Drama",episodes:11,duration:"24m",description:"Satu musim panas terus berulang hingga sebuah rahasia akhirnya ditemukan."},
{id:10,title:"Crimson Run",poster:"https://images.unsplash.com/photo-1518837695005-2083093ee35b?w=1200&q=85&sat=-50",score:9.0,year:2026,genre:"Action",episodes:24,duration:"24m",description:"Sebuah perlombaan berubah menjadi pertarungan ketika masa lalu mulai mengejar."}
];
let anime=[], activeHero=0, activeFilter="all", currentAnime=null, searchTerm="";
const $=id=>document.getElementById(id);
const safe=(v,fallback="")=>v==null?fallback:String(v);
function normalize(item,index){
 const genres=Array.isArray(item.genres)?item.genres.join(", "):safe(item.genre,"Anime");
 return {id:item.id??index+1,title:safe(item.title||item.name,"Untitled"),poster:safe(item.poster||item.image||item.cover,"https://placehold.co/1280x800/151320/bdaeff?text=Kurova"),score:Number(item.score||item.rating||0),year:item.year||item.releaseYear||"—",genre:genres,episodes:item.episodes||item.episode_count||"?",duration:item.duration||"24m",description:safe(item.description||item.synopsis,"Belum ada sinopsis untuk anime ini.")};
}
function escapeHTML(value){return safe(value).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
function matches(a){
 const genre=a.genre.toLowerCase(),term=searchTerm.toLowerCase();
 return (activeFilter==="all"||genre.includes(activeFilter))&&(!term||[a.title,a.genre,a.description].join(" ").toLowerCase().includes(term));
}
function cardHTML(a,index,isNew=false){
 return `<article class="card" data-id="${escapeHTML(a.id)}" style="animation-delay:${Math.min(index,8)*35}ms" tabindex="0" role="button" aria-label="Detail ${escapeHTML(a.title)}">
 <div class="poster"><img src="${escapeHTML(a.poster)}" alt="${escapeHTML(a.title)}" loading="lazy" onerror="this.src='https://placehold.co/800x500/171923/c4b5fd?text=Kurova'"><span class="rating">${a.score.toFixed(1)}</span>${isNew?'<span class="badge-new">NEW</span>':''}<button class="play" tabindex="-1" aria-hidden="true">▶</button></div>
 <div class="card-info"><div class="card-title">${escapeHTML(a.title)}</div><div class="card-meta">${escapeHTML(a.year)} · ${escapeHTML(a.genre.split(",")[0])} · ${escapeHTML(a.episodes)} eps</div></div></article>`;
}
function renderGrid(){
 const filtered=anime.filter(matches);
 $("animeGrid").innerHTML=filtered.map((a,i)=>cardHTML(a,i)).join("");
 $("animeCount").textContent=`${filtered.length} anime`;
 $("empty").style.display=filtered.length?"none":"block";
 $("newGrid").innerHTML=[...anime].reverse().slice(0,5).map((a,i)=>cardHTML(a,i,true)).join("");
}
function renderContinue(){
 const items=anime.slice(1,5);
 $("continueGrid").innerHTML=items.map((a,i)=>`<article class="continue-card" data-id="${escapeHTML(a.id)}" tabindex="0" role="button"><img src="${escapeHTML(a.poster)}" alt="" loading="lazy"><div class="continue-info"><div class="continue-title">${escapeHTML(a.title)}</div><div class="progress"><span style="width:${[65,42,83,28][i]}%"></span></div><div class="continue-time">Episode ${i+3} · ${[65,42,83,28][i]}% selesai</div></div></article>`).join("");
}
function renderHero(){
 const a=anime[activeHero%anime.length];if(!a)return;
 $("heroBg").style.backgroundImage=`url("${a.poster}")`;
 $("heroTitle").textContent=a.title;$("heroYear").textContent=a.year;$("heroGenre").textContent=a.genre.split(",")[0];$("heroScore").textContent=`★ ${a.score.toFixed(1)}`;$("heroDesc").textContent=a.description;
 $("heroDots").innerHTML=anime.slice(0,5).map((_,i)=>`<button class="dot ${i===activeHero%Math.min(5,anime.length)?"active":""}" data-slide="${i}" aria-label="Slide ${i+1}"></button>`).join("");
}
function openModal(a){
 if(!a)return;currentAnime=a;
 $("modalCover").style.backgroundImage=`url("${a.poster}")`;
 $("modalTitle").textContent=a.title;
 $("modalMeta").innerHTML=`<span>${escapeHTML(a.year)}</span><span>${escapeHTML(a.genre)}</span><span>★ ${a.score.toFixed(1)}</span><span>${escapeHTML(a.episodes)} episode</span>`;
 $("modalDescription").textContent=a.description;
 $("modalSave").textContent=isSaved(a.id)?"✓ Tersimpan":"＋ Watchlist";
 $("modal").classList.add("open");document.body.style.overflow="hidden";
}
function closeModal(){$("modal").classList.remove("open");document.body.style.overflow="";}
function toast(message){const el=$("toast");el.textContent=message;el.classList.add("show");clearTimeout(toast.timer);toast.timer=setTimeout(()=>el.classList.remove("show"),2300);}
function getSaved(){try{return JSON.parse(localStorage.getItem("kurova-watchlist")||"[]")}catch{return []}}
function isSaved(id){return getSaved().includes(id)}
function toggleSave(a){
 let saved=getSaved();saved=saved.includes(a.id)?saved.filter(x=>x!==a.id):[...saved,a.id];
 localStorage.setItem("kurova-watchlist",JSON.stringify(saved));
 $("modalSave").textContent=isSaved(a.id)?"✓ Tersimpan":"＋ Watchlist";
 toast(isSaved(a.id)?"Ditambahkan ke watchlist":"Dihapus dari watchlist");
}
function playAnime(a){toast(`Preview: ${a.title} · Episode 1`);}
function filterBy(filter){activeFilter=filter;document.querySelectorAll(".chip").forEach(b=>b.classList.toggle("active",b.dataset.filter===filter));renderGrid();}
async function loadAnime(){
 anime=demoAnime.map(normalize);
 renderAll();
 if(!API_URL)return;
 try{
  const response=await fetch(API_URL,{headers:{Accept:"application/json"}});
  if(!response.ok)throw new Error(`HTTP ${response.status}`);
  const payload=await response.json();
  const list=Array.isArray(payload)?payload:(payload.data||payload.results||[]);
  if(!Array.isArray(list)||!list.length)throw new Error("Format API tidak dikenali");
  anime=list.map(normalize);activeHero=0;renderAll();toast("Data anime berhasil dimuat");
 }catch(error){console.warn("Kurova API:",error);toast("API gagal dimuat, memakai data demo");}
}
function renderAll(){renderHero();renderContinue();renderGrid();}
$("searchForm").addEventListener("submit",e=>{e.preventDefault();searchTerm=$("search").value.trim();renderGrid();$("trending").scrollIntoView({behavior:"smooth"});});
$("search").addEventListener("input",e=>{searchTerm=e.target.value.trim();renderGrid();});
$("categories").addEventListener("click",e=>{const b=e.target.closest("[data-filter]");if(b)filterBy(b.dataset.filter);});
document.addEventListener("click",e=>{
 const dot=e.target.closest("[data-slide]");if(dot){activeHero=Number(dot.dataset.slide);renderHero();return;}
 const card=e.target.closest("[data-id]");if(card){const a=anime.find(x=>String(x.id)===card.dataset.id);openModal(a);}
});
document.addEventListener("keydown",e=>{
 if((e.key==="Enter"||e.key===" ")&&e.target.matches(".card,.continue-card")){e.preventDefault();const a=anime.find(x=>String(x.id)===e.target.dataset.id);openModal(a);}
 if(e.key==="Escape")closeModal();
});
$("detailBtn").addEventListener("click",()=>openModal(anime[activeHero]));
$("watchBtn").addEventListener("click",()=>playAnime(anime[activeHero]));
$("modalWatch").addEventListener("click",()=>{playAnime(currentAnime);closeModal();});
$("modalSave").addEventListener("click",()=>currentAnime&&toggleSave(currentAnime));
$("closeModal").addEventListener("click",closeModal);
$("modal").addEventListener("click",e=>{if(e.target===$("modal"))closeModal();});
function showSaved(){const saved=getSaved();if(!saved.length){toast("Watchlist masih kosong");return;}const list=anime.filter(a=>saved.includes(a.id));toast(`Watchlist: ${list.map(a=>a.title).join(", ")}`);}
$("watchlistBtn").addEventListener("click",showSaved);$("sideWatchlist").addEventListener("click",e=>{e.preventDefault();showSaved();});
$("historyBtn").addEventListener("click",()=>toast("Riwayat tontonan demo tersedia di bagian Lanjutkan"));
$("sideHistory").addEventListener("click",e=>{e.preventDefault();toast("Riwayat tontonan demo tersedia di bagian Lanjutkan");});
$("topRatedLink").addEventListener("click",()=>{anime.sort((a,b)=>b.score-a.score);renderAll();});
$("aboutBtn").addEventListener("click",e=>{e.preventDefault();toast("Kurova — Anime, Your Way.");});
$("settingsBtn").addEventListener("click",e=>{e.preventDefault();toast("Pengaturan akan tersedia pada pembaruan berikutnya");});
let slideTimer=setInterval(()=>{if(!document.hidden&&anime.length>1){activeHero=(activeHero+1)%Math.min(5,anime.length);renderHero();}},6500);
document.addEventListener("visibilitychange",()=>{if(document.hidden)clearInterval(slideTimer);else slideTimer=setInterval(()=>{activeHero=(activeHero+1)%Math.min(5,anime.length);renderHero();},6500);});
loadAnime();
</script>
</body>
</html>
